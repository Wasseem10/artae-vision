NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Local mode uses a development-only key visible in the browser. OIDC deployments
# should leave this unset and install access tokens into sessionStorage through a
# standards-compliant Authorization Code + PKCE or backend-for-frontend flow.
NEXT_PUBLIC_DASHBOARD_KEY=replace-with-the-api-dashboard-key

# Copy this file to .env and adjust values for your machine.
VIDEO_INTEL_CAMERA_INDEX=0
VIDEO_INTEL_CAMERA_WIDTH=1280
VIDEO_INTEL_CAMERA_HEIGHT=720
VIDEO_INTEL_CAMERA_FPS=30
VIDEO_INTEL_CAMERA_OPEN_TIMEOUT_SECONDS=10
VIDEO_INTEL_CAMERA_READ_TIMEOUT_SECONDS=10
VIDEO_INTEL_CAMERA_RECONNECT_ATTEMPTS=5
VIDEO_INTEL_CAMERA_RECONNECT_BACKOFF_SECONDS=0.5
# Continuous edge recording is opt-in until an approved retention policy exists.
VIDEO_INTEL_CONTINUOUS_RECORDING_ENABLED=false
# Archive copies are spooled durably and uploaded only when this is enabled.
VIDEO_INTEL_CONTINUOUS_RECORDING_ARCHIVE_ENABLED=false
VIDEO_INTEL_CONTINUOUS_RECORDING_DIRECTORY=artifacts/recordings
VIDEO_INTEL_CONTINUOUS_RECORDING_SPOOL_DIRECTORY=artifacts/recording-upload-spool
VIDEO_INTEL_CONTINUOUS_RECORDING_SEGMENT_SECONDS=60
VIDEO_INTEL_CONTINUOUS_RECORDING_RETENTION_HOURS=2
VIDEO_INTEL_CONTINUOUS_RECORDING_MAX_BYTES=10737418240
VIDEO_INTEL_CONTINUOUS_RECORDING_QUEUE_SIZE=120

# Ultralytics downloads these weights automatically the first time the app runs.
VIDEO_INTEL_MODEL_NAME=yolo26n.pt
# Used automatically for fall/collapse camera jobs; runs locally on every frame.
VIDEO_INTEL_POSE_MODEL_NAME=yolo11n-pose.pt
VIDEO_INTEL_CONFIDENCE_THRESHOLD=0.25
VIDEO_INTEL_IOU_THRESHOLD=0.45

# Leave empty to let Ultralytics choose CPU or GPU automatically.
VIDEO_INTEL_DEVICE=
VIDEO_INTEL_WINDOW_TITLE=AI Video Intelligence - Webcam Detection
VIDEO_INTEL_LOG_LEVEL=INFO

# Continuous semantic observer. It samples one shared camera loop into overlapping
# chronological sheets and sends them asynchronously to the selected VLM.
VIDEO_INTEL_OBSERVER_ENABLED=false
VIDEO_INTEL_OBSERVER_RULE=Alert when an important visible event occurs.
VIDEO_INTEL_OBSERVER_SAMPLE_FPS=1
VIDEO_INTEL_OBSERVER_WINDOW_FRAMES=10
VIDEO_INTEL_OBSERVER_OVERLAP_FRAMES=5
VIDEO_INTEL_OBSERVER_FRAME_WIDTH=320
VIDEO_INTEL_OBSERVER_FRAME_HEIGHT=180
VIDEO_INTEL_OBSERVER_SHEET_COLUMNS=5
VIDEO_INTEL_OBSERVER_QUEUE_SIZE=2
VIDEO_INTEL_OBSERVER_REQUEST_TIMEOUT_SECONDS=30
# "dry_run" needs no key and emits a predictable simulated alert every N windows.
# Use "gemini" for the US-facing prototype; "qwen" remains an optional provider.
VIDEO_INTEL_OBSERVER_PROVIDER=dry_run
VIDEO_INTEL_OBSERVER_DRY_RUN_TRIGGER_EVERY=3
VIDEO_INTEL_OBSERVER_MAX_REQUESTS_PER_MINUTE=1
VIDEO_INTEL_OBSERVER_MAX_REQUESTS_PER_DAY=20
VIDEO_INTEL_REPLAY_MAX_REQUESTS_PER_MINUTE=20
VIDEO_INTEL_REPLAY_MAX_REQUESTS_PER_DAY=20
VIDEO_INTEL_OBSERVER_SHOW_SHEET=true
# none stores nothing, triggered stores alerts, and all stores every analyzed sheet.
VIDEO_INTEL_OBSERVER_ARTIFACT_MODE=triggered
VIDEO_INTEL_OBSERVER_ARTIFACTS_DIRECTORY=artifacts/observer
VIDEO_INTEL_QWEN_API_KEY=
VIDEO_INTEL_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VIDEO_INTEL_QWEN_MODEL=qwen3.7-flash

# Google Gemini provider (preferred for the US-facing prototype).
VIDEO_INTEL_GEMINI_API_KEY=
VIDEO_INTEL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VIDEO_INTEL_GEMINI_MODEL=gemini-3.5-flash-lite
# Must differ from the proposer model for automatic live semantic confirmation.
VIDEO_INTEL_GEMINI_VERIFIER_MODEL=gemini-3.7-flash

# Milestone 2 agent: use webcam:0, a local MP4 path, or an rtsp:// URL.
VIDEO_INTEL_AGENT_SOURCE=webcam:0
VIDEO_INTEL_CAMERA_ID=camera-1
VIDEO_INTEL_ZONE_NAME=loading-zone
# Polygon points are normalized x,y pairs, so they work at any resolution.
VIDEO_INTEL_ZONE_POINTS=0.20,0.20;0.80,0.20;0.80,0.90;0.20,0.90
VIDEO_INTEL_DWELL_RULE_ID=person-dwell
VIDEO_INTEL_DWELL_SECONDS=10
VIDEO_INTEL_TRACKING_ABSENCE_GRACE_SECONDS=1
VIDEO_INTEL_EVIDENCE_PRE_SECONDS=2
VIDEO_INTEL_EVIDENCE_POST_SECONDS=5
VIDEO_INTEL_EVENTS_DIRECTORY=artifacts/events
VIDEO_INTEL_OFFLINE_OUTBOX_PATH=artifacts/offline/event-outbox.db
VIDEO_INTEL_WEBHOOK_TIMEOUT_SECONDS=10
# Uncomment to send each event as JSON from a background thread.
# VIDEO_INTEL_WEBHOOK_URL=https://your-system.example/events

# Send inference events into the FastAPI control plane.
# VIDEO_INTEL_CONTROL_PLANE_URL=http://127.0.0.1:8000
# Production: paste the one-time token returned when an edge device is enrolled.
# VIDEO_INTEL_CONTROL_PLANE_DEVICE_TOKEN=vid1.device-uuid.random-secret
# Local development only: the API can still accept the shared internal key.
# VIDEO_INTEL_CONTROL_PLANE_AGENT_KEY=replace-with-the-same-long-api-agent-key
# VIDEO_INTEL_CONTROL_PLANE_CAMERA_REF=camera-1
# Set this only to debug one active job; managed workers run every active job.
# VIDEO_INTEL_CONTROL_PLANE_RULE_REF=person-dwell

# Milestone 13 supervisor. One process runs several independently leased cameras.
VIDEO_INTEL_WORKER_ID=
VIDEO_INTEL_WORKER_POLL_SECONDS=2
VIDEO_INTEL_WORKER_TELEMETRY_SECONDS=0.5
VIDEO_INTEL_WORKER_HEARTBEAT_SECONDS=2
# Native dashboard preview fallback. Frames stay local unless the API URL points
# at a remote control plane; production live video uses MediaMTX instead.
VIDEO_INTEL_WORKER_PREVIEW_FPS=2
VIDEO_INTEL_WORKER_PREVIEW_WIDTH=960
VIDEO_INTEL_WORKER_PREVIEW_JPEG_QUALITY=75
VIDEO_INTEL_WORKER_MAX_CAMERAS=1
VIDEO_INTEL_CAMERA_DISCOVERY_MAX_DEVICES=100
VIDEO_INTEL_CAMERA_ONBOARDING_TIMEOUT_SECONDS=10
VIDEO_INTEL_REPLAY_INPUT_PRICE_PER_MILLION_USD=0
VIDEO_INTEL_REPLAY_OUTPUT_PRICE_PER_MILLION_USD=0

# FastAPI control-plane settings. Use different secrets outside local development.
VIDEO_INTEL_API_DATABASE_URL=postgresql+psycopg://video_intelligence:video_intelligence@localhost:5432/video_intelligence
VIDEO_INTEL_API_AGENT_KEY=replace-with-a-random-agent-key-at-least-16-characters
VIDEO_INTEL_API_AGENT_RESTART_BACKOFF_BASE_SECONDS=5
VIDEO_INTEL_API_AGENT_RESTART_BACKOFF_MAX_SECONDS=300
VIDEO_INTEL_API_CAMERA_DISCOVERY_LEASE_SECONDS=30
VIDEO_INTEL_API_CAMERA_ONBOARDING_LEASE_SECONDS=60
# "development" permits the shared key for camera agents. Production requires "device".
VIDEO_INTEL_API_EDGE_AUTH_MODE=development
VIDEO_INTEL_API_DASHBOARD_KEY=replace-with-a-random-dashboard-key-at-least-16-characters
# "development" accepts the dashboard key, "hybrid" also accepts OIDC for local signup,
# and production "oidc" requires signed bearer tokens.
VIDEO_INTEL_API_DASHBOARD_AUTH_MODE=development
VIDEO_INTEL_API_RECORDING_ARCHIVE_DIRECTORY=artifacts/recording-archive
VIDEO_INTEL_API_RECORDING_UPLOAD_MAX_BYTES=1073741824
VIDEO_INTEL_API_RECORDING_RETENTION_HOURS=2
# Use "supabase" or "s3" in hosted deployments. "local" keeps native development zero-setup.
VIDEO_INTEL_API_RECORDING_STORAGE_BACKEND=local
# Required in OIDC mode. The org claim must contain a provisioned organization UUID.
VIDEO_INTEL_API_OIDC_ISSUER=
VIDEO_INTEL_API_OIDC_AUDIENCE=
VIDEO_INTEL_API_OIDC_JWKS_URL=
VIDEO_INTEL_API_OIDC_ORGANIZATION_CLAIM=org_id
VIDEO_INTEL_API_OIDC_ROLE_CLAIM=role
VIDEO_INTEL_API_OIDC_ALGORITHMS=["RS256","ES256"]
# Keep false when database memberships are administered with video-intelligence-admin.
VIDEO_INTEL_API_OIDC_AUTO_PROVISION_MEMBERSHIPS=false
# Enable for self-serve signup. A first-time identity receives an isolated personal workspace.
VIDEO_INTEL_API_OIDC_AUTO_PROVISION_ORGANIZATIONS=false

# Supabase Auth for the Next.js application. Only use the browser-safe publishable key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same value across API restarts or existing webhook secrets cannot be decrypted.
VIDEO_INTEL_API_ALERT_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Independent Fernet key for ONVIF and RTSP camera credentials.
VIDEO_INTEL_API_CAMERA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Independent random secret used for short-lived, tenant-bound clip playback URLs.
VIDEO_INTEL_API_MEDIA_SIGNING_KEY=replace-with-a-random-media-signing-key-at-least-32-characters
VIDEO_INTEL_API_MEDIA_URL_TTL_SECONDS=300
# Hosted deployment prerequisites. The readiness report keeps these visible until
# actual providers and an approved data-retention policy have been selected.
VIDEO_INTEL_API_REDIS_URL=
VIDEO_INTEL_API_OBJECT_STORAGE_ENDPOINT=
VIDEO_INTEL_API_OBJECT_STORAGE_BUCKET=
VIDEO_INTEL_API_OBJECT_STORAGE_REGION=us-east-1
VIDEO_INTEL_API_OBJECT_STORAGE_ACCESS_KEY=
VIDEO_INTEL_API_OBJECT_STORAGE_SECRET_KEY=
VIDEO_INTEL_API_OBJECT_STORAGE_SESSION_TOKEN=
VIDEO_INTEL_API_OBJECT_STORAGE_FORCE_PATH_STYLE=true
VIDEO_INTEL_API_OBJECT_STORAGE_PRESIGN_SECONDS=300
# Server-only Supabase Storage credentials. Never prefix the secret with NEXT_PUBLIC_.
VIDEO_INTEL_API_SUPABASE_URL=
VIDEO_INTEL_API_SUPABASE_SECRET_KEY=
VIDEO_INTEL_API_BACKUP_TARGET=
VIDEO_INTEL_API_RETENTION_POLICY_CONFIGURED=false
VIDEO_INTEL_API_HOST=127.0.0.1
VIDEO_INTEL_API_PORT=8000
VIDEO_INTEL_API_LOG_LEVEL=INFO
# JSON array of trusted browser origins. Do not use "*" with credentials.
VIDEO_INTEL_API_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# MediaMTX Control API stays server-side; the browser receives only playback URLs.
VIDEO_INTEL_API_MEDIA_GATEWAY_API_URL=http://127.0.0.1:9997
VIDEO_INTEL_API_MEDIA_GATEWAY_WEBRTC_URL=http://127.0.0.1:8889
VIDEO_INTEL_API_MEDIA_GATEWAY_RTSP_URL=rtsp://127.0.0.1:8554
VIDEO_INTEL_API_MEDIA_GATEWAY_TIMEOUT_SECONDS=5
# How long a worker owns an assignment without another heartbeat.
VIDEO_INTEL_API_AGENT_LEASE_SECONDS=10
# Replay workers renew this lease while processing uploaded video.
VIDEO_INTEL_API_REPLAY_LEASE_SECONDS=900
VIDEO_INTEL_API_REPLAY_DIRECTORY=artifacts/replays
# Default browser upload limit: 512 MiB.
VIDEO_INTEL_API_REPLAY_MAX_BYTES=536870912
VIDEO_INTEL_API_EVIDENCE_DIRECTORY=artifacts/evidence
VIDEO_INTEL_API_EVIDENCE_MAX_BYTES=536870912
VIDEO_INTEL_API_EVIDENCE_LEASE_SECONDS=1800
VIDEO_INTEL_API_ALERT_LEASE_SECONDS=60
VIDEO_INTEL_API_ALERT_RETRY_BASE_SECONDS=5
VIDEO_INTEL_API_ALERT_RETRY_MAX_SECONDS=900
# Native latest-frame fallback limits. The preview is process-local and expires.
VIDEO_INTEL_API_PREVIEW_MAX_BYTES=2097152
VIDEO_INTEL_API_PREVIEW_TTL_SECONDS=5
# Edge workers hold camera health-check work briefly so a failed station can be retried.
VIDEO_INTEL_API_CAMERA_COMMISSIONING_LEASE_SECONDS=90
# Always-on reliability watchdog thresholds. Intentionally stopped cameras are excluded.
VIDEO_INTEL_API_OPERATIONAL_HEALTH_CAMERA_GRACE_SECONDS=30
VIDEO_INTEL_API_OPERATIONAL_HEALTH_CAMERA_STALE_SECONDS=20
VIDEO_INTEL_API_OPERATIONAL_HEALTH_FRAME_STALE_SECONDS=15
VIDEO_INTEL_API_OPERATIONAL_HEALTH_EDGE_STALE_SECONDS=30
# "auto" uses OpenAI only when a key is present; otherwise it uses the local parser.
VIDEO_INTEL_API_RULE_COMPILER_PROVIDER=auto
# VIDEO_INTEL_API_OPENAI_API_KEY=
VIDEO_INTEL_API_OPENAI_RULE_COMPILER_MODEL=gpt-5-mini
# Hackathon incident coordinator. Strands uses Amazon Bedrock and only runs after
# the vision pipeline confirms an event; provider failure never suppresses alerts.
VIDEO_INTEL_API_STRANDS_ENABLED=false
VIDEO_INTEL_API_STRANDS_MODEL_ID=us.amazon.nova-2-lite-v1:0
VIDEO_INTEL_API_STRANDS_REGION=us-east-1
# Optional: restricted Vercel OIDC role; no permanent AWS keys in the browser.
VIDEO_INTEL_API_STRANDS_ROLE_ARN=
VIDEO_INTEL_API_STRANDS_TIMEOUT_SECONDS=30
VIDEO_INTEL_API_SMS_ENABLED=false
VIDEO_INTEL_API_SMS_REGION=us-east-1
VIDEO_INTEL_API_SMS_SENDER_ID=
# Configure one supported AWS credential method. Prefer an IAM role on AWS;
# locally, `aws configure` is safer than committing credentials to this file.
# AWS_BEARER_TOKEN_BEDROCK=
# Capability registry advertised by this deployment. JSON arrays can be replaced
# when a licensed/custom model is installed; jobs outside the list cannot activate.
VIDEO_INTEL_API_DETECTOR_MODEL=yolo26n.pt
# VIDEO_INTEL_API_OBJECT_CLASSES=["person","car","truck"]
# VIDEO_INTEL_API_EVENT_TYPES=["zone_dwell","zone_presence","zone_entry","zone_exit","count_threshold","line_crossing","semantic_vision"]
# Set to disabled only for the no-Docker native dashboard. Production and the
# complete local stack use MediaMTX for browser-compatible live video.
# VIDEO_INTEL_API_MEDIA_GATEWAY_MODE=mediamtx

# Optional Artae evidence worker. It can remain stopped while the internal Labs
# gateway returns 501; clip playback and local metadata search still work.
VIDEO_INTEL_EVIDENCE_CONTROL_PLANE_URL=http://127.0.0.1:8000
VIDEO_INTEL_EVIDENCE_AGENT_KEY=replace-with-the-same-long-api-agent-key
VIDEO_INTEL_EVIDENCE_WORKER_ID=
VIDEO_INTEL_EVIDENCE_POLL_SECONDS=2

# Durable signed-webhook delivery worker. This uses the same internal agent key.
VIDEO_INTEL_ALERT_CONTROL_PLANE_URL=http://127.0.0.1:8000
VIDEO_INTEL_ALERT_AGENT_KEY=replace-with-the-same-long-api-agent-key
VIDEO_INTEL_ALERT_WORKER_ID=my-alert-worker
VIDEO_INTEL_ALERT_POLL_SECONDS=1
VIDEO_INTEL_ALERT_HEALTH_EVALUATION_SECONDS=10
VIDEO_INTEL_ALERT_EVIDENCE_SAMPLING_SECONDS=30

# Artae Labs is an internal service. Permission has been confirmed, but you still
# need an actual API key and possibly a different internal gateway URL to call it.
ARTAE_LABS_API_KEY=
ARTAE_LABS_INDEX_ID=
ARTAE_LABS_BASE_URL=https://api.cadere.studio/api/v1/labs
ARTAE_LABS_REQUEST_TIMEOUT_SECONDS=30
ARTAE_LABS_POLL_INTERVAL_SECONDS=5
ARTAE_LABS_INDEXING_TIMEOUT_SECONDS=900
